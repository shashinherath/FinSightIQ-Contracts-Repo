{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finsightiq:schema:prediction-generated:v1",
  "title": "PredictionGenerated",
  "description": "A new forecast was produced by the Prediction Service. Routing key prediction.generated. Mirrors FinSightIQ.Contracts.Events.PredictionGenerated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["predictionId", "symbol", "confidence", "recommendation"],
  "properties": {
    "predictionId": {
      "type": "string",
      "format": "uuid"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Interval-derived confidence. Not the probability that the price will be reached."
    },
    "recommendation": {
      "type": "string",
      "enum": ["BUY", "HOLD", "SELL"],
      "description": "Mechanical mapping from trend and confidence. Not financial advice."
    },
    "predictedPrice": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "lowerBound": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "upperBound": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "trend": {
      "type": "string",
      "enum": ["UP", "DOWN", "FLAT"]
    },
    "forecastDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "modelUsed": {
      "type": "string",
      "enum": ["prophet", "arima", "lstm", "ensemble"]
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "degraded": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "topFeatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contribution"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "contribution": {
            "type": "number",
            "description": "Signed SHAP value."
          }
        }
      }
    }
  }
}
